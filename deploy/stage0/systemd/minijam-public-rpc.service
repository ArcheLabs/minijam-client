[Unit]
Description=MiniJAM Stage-0 Public RPC Node
After=network-online.target
Wants=network-online.target

[Service]
User=minijam
Group=minijam
ExecStart=/usr/local/bin/minijam-node \
  --chain /etc/minijam/stage0-raw.json \
  --name stage0-public-rpc \
  --base-path /var/lib/minijam/public-rpc \
  --rpc-external \
  --rpc-methods safe \
  --rpc-rate-limit 600 \
  --rpc-max-request-size 8 \
  --rpc-max-response-size 64 \
  --rpc-cors https://polkadot.js.org \
  --prometheus-external \
  --prometheus-port 9615
Restart=on-failure
RestartSec=10
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
