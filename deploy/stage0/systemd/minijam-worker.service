[Unit]
Description=MiniJAM Stage-0 Worker
After=network-online.target minijam-public-rpc.service
Wants=network-online.target

[Service]
User=minijam
Group=minijam
ExecStart=/usr/local/bin/minijam-worker --config /etc/minijam/worker.toml
Restart=on-failure
RestartSec=10
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
