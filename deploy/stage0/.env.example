# Copy this file to deploy/stage0/.env and replace every placeholder.
# Image values must come from release-manifest.json and use immutable digests.
MINIJAM_NODE_IMAGE=ghcr.io/archelabs/minijam-node@sha256:replace-with-release-digest
MINIJAM_WORKER_IMAGE=ghcr.io/archelabs/minijam-worker@sha256:replace-with-release-digest
MINIJAM_COMPILER_IMAGE=ghcr.io/archelabs/minijam-compiler-api@sha256:replace-with-release-digest
MINIJAM_PLAYGROUND_API_IMAGE=ghcr.io/archelabs/minijam-playground-api@sha256:replace-with-release-digest
MINIJAM_PLAYGROUND_WEB_IMAGE=ghcr.io/archelabs/minijam-playground-web@sha256:replace-with-release-digest

MINIJAM_CHAIN_SPEC_PATH=./chain-specs/stage0-raw.json
MINIJAM_GENESIS_HASH=replace-with-release-genesis-hash
MINIJAM_RELAYER_URI=

NODE_KEY_OR_SEED_PATH=./deploy/stage0/secrets/node-keystore
WORKER_1_SEED_PATH=./deploy/stage0/secrets/worker-1.seed
WORKER_2_SEED_PATH=./deploy/stage0/secrets/worker-2.seed
WORKER_3_SEED_PATH=./deploy/stage0/secrets/worker-3.seed

MINIJAM_WEB_BIND=127.0.0.1
MINIJAM_WEB_PORT=4173
