# Public AccountId32 values only. Never put mnemonics or private keys here.
MINIJAM_STAGE1_INGRESS_RELAYER_PUBLIC_KEY=0x<64-hex-bytes>
MINIJAM_STAGE1_ALLOCATION_RELAYER_PUBLIC_KEY=0x<64-hex-bytes>
MINIJAM_STAGE1_CHAIN_SPEC_FILE=./chain-specs/stage1.json
MINIJAM_WORKER_KEY_FILE=./secrets/worker.seed
MINIJAM_FORMAL_RPC_RELAYER_KEY_FILE=./secrets/work-ingress.seed
MINIJAM_NODE_IMAGE=ghcr.io/archelabs/minijam-node:stage1
MINIJAM_WORKER_IMAGE=ghcr.io/archelabs/minijam-worker:stage1
MINIJAM_FORMAL_RPC_IMAGE=ghcr.io/archelabs/minijam-formal-rpc:stage1

