# The built-in `testnet` chain spec is deterministic and needs no public-key
# or chain-spec input. Secret values are consumed by Compose as
# /run/secrets/* files. Keep this file private and replace every example
# before starting a deployment. The worker and relayer secrets must match the
# canonical testnet identities embedded in the node binary.
MINIJAM_NODE_NETWORK_KEY=0x<64-hex-bytes>
MINIJAM_WORKER_SEED=0x<64-hex-bytes>
MINIJAM_FORMAL_RPC_RELAYER_URI=0x<64-hex-bytes>
MINIJAM_NODE_IMAGE=ghcr.io/archelabs/minijam-node:stage1
MINIJAM_WORKER_IMAGE=ghcr.io/archelabs/minijam-worker:stage1
MINIJAM_FORMAL_RPC_IMAGE=ghcr.io/archelabs/minijam-formal-rpc:stage1
