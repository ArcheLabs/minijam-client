FROM node:22-bookworm-slim AS builder
WORKDIR /src/apps/playground-web
COPY apps/playground-web/package.json apps/playground-web/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY apps/playground-web/ ./
COPY test-vectors /src/test-vectors
ARG VITE_MINIJAM_GENESIS_HASH
ARG VITE_TEST_WALLET=false
ARG VITE_LOCAL_DEVELOPMENT=false
ENV VITE_MINIJAM_GENESIS_HASH=${VITE_MINIJAM_GENESIS_HASH}
ENV VITE_TEST_WALLET=${VITE_TEST_WALLET}
ENV VITE_LOCAL_DEVELOPMENT=${VITE_LOCAL_DEVELOPMENT}
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/local/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /src/apps/playground-web/dist /usr/share/nginx/html
EXPOSE 8080
