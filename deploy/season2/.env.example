# Never commit private key values. The two public keys below are used only when
# generating the chain spec; the corresponding private keys stay in secret
# storage owned by the relay and worker operators.
MINIJAM_SEASON2_INGRESS_RELAYER_PUBLIC_KEY=0x<64-hex-bytes>
MINIJAM_SEASON2_ALLOCATION_RELAYER_PUBLIC_KEY=0x<64-hex-bytes>
MINIJAM_RELAYER_URI=//<ingress-relayer-secret>
MINIJAM_ALLOCATION_RELAYER_URI=//<allocation-relayer-secret>
MINIJAM_WORKER_KEY_FILE=./secrets/worker.seed
MINIJAM_WORKER_IPFS_GATEWAY=http://api:8080/ipfs
MINIJAM_SEASON2_CHAIN_SPEC_FILE=./chain-specs/season2.json
