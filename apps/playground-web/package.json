    "test:season2": "playwright test --config playwright.season2.config.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@polkadot/extension-dapp": "^0.62.6",
    "@polkadot/util": "^14.0.1",
    "@polkadot/util-crypto": "^14.0.1",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@rollup/wasm-node": "^4.50.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.50.0"
